# ============================================================
# Viniyog ONE - Google Startup Buildathon Environment Config
# ============================================================

# Google Cloud Vertex AI Configuration (Application Default Credentials - ADC)
LLM_PROVIDER=vertexai
GOOGLE_CLOUD_PROJECT="lakshos"
GOOGLE_VERTEX_LOCATION="global"

# Models Configuration
# Normal Tasks (Input Guardrail, Simple Chit-Chat):
GOOGLE_NORMAL_MODEL="gemini-2.5-flash"
# Reasoning Tasks (Intent Classifier, Clarification, Cognitive Reasoning ReAct Agent):
GOOGLE_REASONING_MODEL="gemini-3.1-pro-preview"

# Database Configuration
# Set MONGO_SIMULATION=true for standalone development (uses in-memory mongomock seeded from backend/profiles_data/)
# Set MONGO_SIMULATION=false for production MongoDB
MONGO_SIMULATION=false
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/"
MONGO_DB_NAME="viniyogone_db"

# Web Search Tooling (Tavily Search API)
TAVILY_API_KEY="your-tavily-api-key"

# Application Settings
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# LangSmith Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-langsmith-api-key-here"
LANGSMITH_PROJECT="Google-Buildathon-VO"
